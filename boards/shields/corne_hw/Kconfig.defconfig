# The dongle is the split central; both halves are peripherals.

if SHIELD_CORNE_HW_DONGLE

config ZMK_KEYBOARD_NAME
    default "Baikal"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT
    default y

# Left and right halves
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# 2 peripherals + 5 host BT profiles
config BT_MAX_CONN
    default 7

config BT_MAX_PAIRED
    default 7

endif

if SHIELD_CORNE_HW_LEFT || SHIELD_CORNE_HW_RIGHT

config ZMK_SPLIT
    default y

config ZMK_SPLIT_ROLE_CENTRAL
    default n

endif

# config/nrf52840_mdk_usb_dongle.conf sets this board up the way ZMK's own
# board variants are (BLE/USB, flash settings, UF2), so declare it compatible.
# Without this, ZMK's GitHub workflow fails its "board without ZMK compat" step.
if BOARD_NRF52840_MDK_USB_DONGLE

config ZMK_BOARD_COMPAT
    default y

endif
